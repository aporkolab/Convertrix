{
  "name": "convertrix",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npx serve -s dist/convertrix",
    "build": "ng build --configuration=production",
    "watch": "ng build --watch --configuration=development",
    "test": "ng test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,html,scss,json}\"",
    "prepare": "husky",
    "test:dependency-guards": "node --test vendor/braces/test.cjs"
  },
  "type": "module",
  "private": true,
  "homepage": "https://convertrix.porkolab.hu",
  "dependencies": {
    "@angular/common": "22.2.4",
    "@angular/compiler": "22.2.4",
    "@angular/core": "22.2.4",
    "@angular/forms": "22.2.4",
    "@angular/platform-browser": "22.2.4",
    "@angular/router": "22.2.4",
    "bootstrap": "^5.3.8",
    "rxjs": "^7.8.2",
    "tslib": "^2.9.1",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular/build": "22.2.5",
    "@angular/cli": "22.2.5",
    "@angular/compiler-cli": "22.2.4",
    "@types/jasmine": "~6.0.0",
    "braces": "file:vendor/braces",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jasmine-core": "^6.3.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.3.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "engines": {
    "node": "^24.15.0"
  },
  "overrides": {
    "braces": "$braces"
  }
}
